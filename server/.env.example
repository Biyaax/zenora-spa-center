PORT=4000
CLIENT_URL=http://localhost:5173
DB_PATH=./database/zenora.db

# Required in production. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_HOURS=12

SPA_NAME=Zenora Spa & Massage Wellness Center
SPA_TIMEZONE=Asia/Manila

# Optional: email (booking confirmations, reminders, receipts).
# Leave SMTP_HOST empty to print emails to the server console instead.
# If you set it, also run: npm install nodemailer
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Zenora Spa <no-reply@zenora.example>
